From: Varun Gupta <varun.gupta@intel.com>
Subject: [PATCH] drm/gem: stub out huge_mnt accessor for older kernels

drm_device->huge_mnt was added in v7.0 for transparent hugepage tmpfs
mount support. On older kernels return NULL.

Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 include/drm/drm_gem.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/drm/drm_gem.h b/include/drm/drm_gem.h
--- a/include/drm/drm_gem.h
+++ b/include/drm/drm_gem.h
@@ -518,9 +518,13 @@ static inline bool drm_gem_object_is_shared_for_memory_stats(struct drm_gem_obje
  */
 static inline struct vfsmount *drm_gem_get_huge_mnt(struct drm_device *dev)
 {
+#ifdef BPM_DRM_GEM_HUGE_MNT_NOT_PRESENT
+	return NULL;
+#else
 #ifdef CONFIG_TRANSPARENT_HUGEPAGE
 	return dev->huge_mnt;
 #else
 	return NULL;
 #endif
+#endif
 }
-- 
2.34.1
